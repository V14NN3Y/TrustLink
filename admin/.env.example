# Supabase (Project Settings > API). The anon key is public by design; RLS protects the data.
# NEVER put the service_role key here or in any VITE_ variable.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# VITE_ADMIN_INVITE_CODE is no longer used: admin invitation codes are generated
# in the admin app (Profile > Team) and checked by the database (invitation_codes table).

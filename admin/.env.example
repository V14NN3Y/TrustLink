# Supabase (Project Settings > API). The anon key is public by design; RLS protects the data.
# NEVER put the service_role key here or in any VITE_ variable.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Invite code required to register a new admin account (src/pages/auth/Register.jsx).
# Visible in the built JS bundle, so treat it as a soft gate only.
VITE_ADMIN_INVITE_CODE=choose_a_code_and_share_it_privately
